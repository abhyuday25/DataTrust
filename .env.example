APP_ENV=development
DUCKDB_PATH=./storage/datatrust.duckdb
DATA_DIR=./data/uploads
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173
# Set LLM_MODEL and EMBEDDING_MODEL to locally installed Ollama models.
LLM_PROVIDER=ollama
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=
FAISS_INDEX_PATH=./storage/faiss
RAG_TOP_K=5
MAX_RESULT_ROWS=10000
QUERY_TIMEOUT_SECONDS=10
MAX_REPAIR_ATTEMPTS=2
