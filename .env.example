APP_ENV=development
DUCKDB_PATH=./storage/datatrust.duckdb
DATA_DIR=./data/uploads
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173
# Set provider/model/key to enable Phase 2 queries. Keys stay server-side.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=
FAISS_INDEX_PATH=./storage/faiss
RAG_TOP_K=5
MAX_RESULT_ROWS=10000
QUERY_TIMEOUT_SECONDS=10
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
MAX_REPAIR_ATTEMPTS=2
JWT_SECRET=
